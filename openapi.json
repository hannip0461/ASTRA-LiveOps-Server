  },
  "components": {
    "schemas": {
      "ClaimMailCommand": {
        "required": [
          "mailId",
          "idempotencyKey",
          "requestHash"
        ],
        "type": "object",
        "properties": {
          "mailId": {
            "type": "string"
          },
          "idempotencyKey": {
            "type": "string"
          },
          "requestHash": {
            "type": "string"
          }
        }
      },
      "CreateIncidentMailCommand": {
        "required": [
          "incidentId",
          "mailId",
          "title",
          "body",
          "targetPlayerIds",
          "rewards",
          "reason"
        ],
        "type": "object",
        "properties": {
          "incidentId": {
            "type": "string"
          },
          "mailId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "targetPlayerIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "rewards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MailRewardDto"
            }
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "CurrencyCode": {
        "type": "integer"
      },
      "DevOperatorTokenRequest": {
        "required": [
          "operatorId"
        ],
        "type": "object",
        "properties": {
          "operatorId": {
            "type": "string"
          }
        }
      },
      "DrawGachaRequest": {
        "required": [
          "bannerId",
          "drawCount",
          "idempotencyKey",
          "requestHash"
        ],
        "type": "object",
        "properties": {
          "bannerId": {
            "type": "string"
          },
          "drawCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "idempotencyKey": {
            "type": "string"
          },
          "requestHash": {
            "type": "string"
          }
        }
      },
      "GachaBannerConfigDto": {
        "required": [
          "bannerId",
          "costCurrency",
          "costAmount",
          "pityThreshold",
          "startsAtUtc",
          "endsAtUtc",
          "rewardPool"
        ],
        "type": "object",
        "properties": {
          "bannerId": {
            "type": "string"
          },
          "costCurrency": {
            "$ref": "#/components/schemas/CurrencyCode"
          },
          "costAmount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "pityThreshold": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "startsAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "endsAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "rewardPool": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GachaRewardPoolEntryDto"
            }
          }
        }
      },
      "GachaRewardKind": {
        "type": "integer"
      },
      "GachaRewardPoolEntryDto": {
        "required": [
          "kind",
          "rewardId",
          "quantity",
          "rarity",
          "weight",
          "isPityTarget",
          "duplicateItemId",
          "duplicateItemQuantity"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/GachaRewardKind"
          },
          "rewardId": {
            "type": "string"
          },
          "quantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "rarity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "weight": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "isPityTarget": {
            "type": "boolean"
          },
          "duplicateItemId": {
            "type": [
              "null",
              "string"
            ]
          },
          "duplicateItemQuantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "GrantCurrencyCommand": {
        "required": [
          "currency",
          "amount",
          "reason",
          "idempotencyKey",
          "requestHash"
        ],
        "type": "object",
        "properties": {
          "currency": {
            "$ref": "#/components/schemas/CurrencyCode"
          },
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "reason": {
            "type": "string"
          },
          "idempotencyKey": {
            "type": "string"
          },
          "requestHash": {
            "type": "string"
          }
        }
      },
      "MailRewardDto": {
        "required": [
          "currency",
          "amount"
        ],
        "type": "object",
        "properties": {
          "currency": {
            "$ref": "#/components/schemas/CurrencyCode"
          },
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "PublishContentCommand": {
        "required": [
          "version",
          "gachaBanners"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "gachaBanners": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GachaBannerConfigDto"
            }
          },
          "reason": {
            "type": "string",
            "default": ""
          }
        }
      },
      "ReplayOutboxEventCommand": {
        "required": [
          "reason"
        ],
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          }
        }
      },
      "RollbackContentCommand": {
        "required": [
          "reason"
        ],
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          }
        }
      },
      "SpendCurrencyCommand": {
        "required": [
          "currency",
          "amount",
          "reason",
          "idempotencyKey",
          "requestHash"
        ],
        "type": "object",
        "properties": {
          "currency": {
            "$ref": "#/components/schemas/CurrencyCode"
          },
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "reason": {
            "type": "string"
          },
          "idempotencyKey": {
            "type": "string"
          },
          "requestHash": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Program"
    },
    {
      "name": "Astra.Api"
    },
    {
      "name": "AdminEndpoints"
    },
    {
      "name": "PlayerEndpoints"
    }
  ]
}