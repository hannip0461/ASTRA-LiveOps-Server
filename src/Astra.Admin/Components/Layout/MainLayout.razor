@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <header class="top-row px-4">
            <AuthorizeView Context="authentication">
                <Authorized>
                    <div class="operator-identity">
                        <strong>@authentication.User.Identity?.Name</strong>
                        <span>@RoleLabel(authentication.User.FindFirst(ClaimTypes.Role)?.Value)</span>
                    </div>
                    <form method="post" action="/auth/sign-out">
                        <AntiforgeryToken />
                        <button class="btn btn-sm btn-outline-secondary" type="submit">로그아웃</button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </header>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    처리 중 오류가 발생했습니다.
    <a href="." class="reload">새로고침</a>
    <span class="dismiss" title="닫기">🗙</span>
</div>

@code {
    private static string RoleLabel(string? role) => role switch
    {
        "LiveOpsViewer" => "조회자",
        "LiveOpsOperator" => "운영자",
        "LiveOpsSupervisor" => "책임자",
        _ => role ?? ""
    };
}
