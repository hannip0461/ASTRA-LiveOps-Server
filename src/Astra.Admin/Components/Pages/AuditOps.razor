@page "/audit"
@rendermode InteractiveServer
@using System.Text.Json
@using Astra.Admin.Services
@using Astra.Contracts
@attribute [Authorize]
@inject AuditAdminApiClient ApiClient

<PageTitle>감사 로그</PageTitle>

<section class="ops-header">
    <div>
        <p class="eyebrow">운영 감사</p>
        <h1>운영 작업 감사 로그</h1>
        <p class="muted">인증된 운영 작업과 완료되지 않은 변경을 확인합니다.</p>
    </div>
    <div class="audit-controls">
        <select class="form-control" @bind="statusFilter">
            <option value="">전체 상태</option>
            @foreach (var status in Enum.GetValues<OperationAuditStatus>())
            {
                <option value="@status">@StatusLabel(status)</option>
            }
        </select>
        <button class="btn btn-outline-secondary" @onclick="LoadAsync" disabled="@busy">새로고침</button>
    </div>
</section>

<section class="ops-panel">
    <div class="panel-heading">
        <h2>최근 작업</h2>
        <span class="status status-draft">@(FilteredEntries.Count)건</span>
    </div>

    @if (entries.Count == 0)
    {
        <p class="muted">운영 감사 기록이 없습니다.</p>
    }
    else
    {
        <div class="table-scroll">
            <table class="ops-table audit-table">
                <thead>
                    <tr>
                        <th>시작 시각</th>
                        <th>상태</th>
                        <th>작업자</th>
                        <th>작업</th>
                        <th>대상</th>
                        <th>사유</th>
                        <th>연관 ID</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in FilteredEntries)
                    {
                        <tr>
                            <td>@entry.StartedAtUtc.ToString("MM-dd HH:mm:ss")</td>
                            <td><span class="status @StatusClass(entry.Status)">@StatusLabel(entry.Status)</span></td>
                            <td>
                                <strong>@entry.ActorDisplayName</strong>
                                <div class="muted mono">@entry.ActorId</div>
                                <div class="muted">@RoleLabel(entry.ActorRole)</div>
                            </td>
                            <td>
                                <strong>@ActionLabel(entry.Action)</strong>
                                <div class="muted mono">@entry.Action</div>
                            </td>
                            <td>
                                <strong>@TargetTypeLabel(entry.TargetType)</strong>
                                <div class="mono">@entry.TargetId</div>
                            </td>
                            <td>
                                @entry.Reason
                                <details>
                                    <summary>상세 정보</summary>
                                    <pre class="audit-json">@FormatDetails(entry)</pre>
                                </details>
                            </td>
                            <td class="mono">@entry.CorrelationId</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@if (!string.IsNullOrWhiteSpace(error))
{
    <section class="result result-error"><strong>@error</strong></section>
}

@code {
    private IReadOnlyList<OperationAuditDto> entries = [];
    private bool busy;
    private string statusFilter = "";
    private string? error;

    private IReadOnlyList<OperationAuditDto> FilteredEntries =>
        string.IsNullOrWhiteSpace(statusFilter) ||
        !Enum.TryParse<OperationAuditStatus>(statusFilter, out var status)
            ? entries
            : entries.Where(entry => entry.Status == status).ToArray();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        busy = true;
        error = null;
        try
        {
            entries = await ApiClient.GetRecentAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException)
        {
            error = exception.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private static string StatusClass(OperationAuditStatus status) => status switch
    {
        OperationAuditStatus.Succeeded => "status-live",
        OperationAuditStatus.Started => "status-warning",
        OperationAuditStatus.Rejected => "status-warning",
        _ => "status-error"
    };

    private static string StatusLabel(OperationAuditStatus status) => status switch
    {
        OperationAuditStatus.Started => "시작",
        OperationAuditStatus.Succeeded => "성공",
        OperationAuditStatus.Rejected => "거부",
        OperationAuditStatus.Failed => "실패",
        _ => status.ToString()
    };

    private static string RoleLabel(string role) => role switch
    {
        LiveOpsRoles.Viewer => "조회자",
        LiveOpsRoles.Operator => "운영자",
        LiveOpsRoles.Supervisor => "책임자",
        _ => role
    };

    private static string ActionLabel(string action) => action switch
    {
        "wallet.grant" => "재화 지급",
        "wallet.spend" => "재화 차감",
        "gacha.draw" => "가챠 실행",
        "mail.claim" => "우편 보상 수령",
        "content.publish" => "콘텐츠 배포",
        "content.rollback" => "콘텐츠 롤백",
        "mail.incident.create" => "사고 보상 우편 생성",
        "outbox.dead_letter.replay" => "최종 실패 이벤트 재처리",
        _ => action
    };

    private static string TargetTypeLabel(string targetType) => targetType switch
    {
        "player" => "플레이어",
        "content-version" => "콘텐츠 버전",
        "mail" => "우편",
        "outbox-event" => "Outbox 이벤트",
        _ => targetType
    };

    private static string FormatDetails(OperationAuditDto entry)
    {
        var details = new
        {
            request = ParseJson(entry.RequestSummary),
            result = ParseJson(entry.ResultSummary),
            entry.ErrorCode,
            entry.SourceIp,
            entry.CompletedAtUtc
        };
        return JsonSerializer.Serialize(details, new JsonSerializerOptions(JsonSerializerDefaults.Web)
        {
            WriteIndented = true
        });
    }

    private static JsonElement? ParseJson(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        using var document = JsonDocument.Parse(value);
        return document.RootElement.Clone();
    }
}
