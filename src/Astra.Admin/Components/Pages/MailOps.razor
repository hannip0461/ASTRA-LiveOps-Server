@page "/mail"
@rendermode InteractiveServer
@using Astra.Admin.Services
@using Astra.Contracts
@attribute [Authorize]
@inject MailAdminApiClient ApiClient

<PageTitle>사고 보상 우편</PageTitle>

<section class="ops-header">
    <div>
        <p class="eyebrow">사고 보상</p>
        <h1>대상자 우편 스냅샷</h1>
        <p class="muted">사고 대상자, 보상과 수령 상태를 관리합니다.</p>
    </div>
    <button class="btn btn-outline-secondary" @onclick="LoadMailAsync" disabled="@busy">우편 조회</button>
</section>

<section class="ops-grid">
    <div class="ops-panel">
        <div class="panel-heading">
            <h2>사고 보상 우편 생성</h2>
            <span class="status status-draft">스냅샷</span>
        </div>

        <div class="form-grid">
            <label>
                사고 ID
                <input class="form-control" @bind="draft.IncidentId" />
            </label>
            <label>
                우편 ID
                <input class="form-control" @bind="draft.MailId" />
            </label>
            <label>
                제목
                <input class="form-control" @bind="draft.Title" />
            </label>
            <label>
                보상
                <div class="input-pair">
                    <select class="form-control" @bind="draft.Currency">
                        @foreach (var currency in Enum.GetNames<CurrencyCode>())
                        {
                            <option value="@currency">@currency</option>
                        }
                    </select>
                    <input class="form-control" type="number" @bind="draft.Amount" />
                </div>
            </label>
        </div>

        <label class="block-label">
            내용
            <textarea class="form-control" rows="3" @bind="draft.Body"></textarea>
        </label>

        <label class="block-label">
            작업 사유
            <input class="form-control" @bind="draft.Reason" />
        </label>

        <label class="block-label">
            대상 플레이어 ID
            <textarea class="form-control mono" rows="7" @bind="draft.TargetPlayerIds"></textarea>
        </label>

        <div class="button-row">
            <AuthorizeView Roles="LiveOpsOperator,LiveOpsSupervisor">
                <button class="btn btn-primary" @onclick="CreateMailAsync" disabled="@busy">우편 생성</button>
            </AuthorizeView>
            <button class="btn btn-outline-secondary" @onclick="ResetDraft" disabled="@busy">초기화</button>
        </div>
    </div>

    <div class="ops-panel">
        <div class="panel-heading">
            <h2>우편 정의</h2>
            <span class="status @(mail is null ? "status-empty" : "status-live")">@(mail is null ? "없음" : "준비")</span>
        </div>

        <div class="lookup-row">
            <input class="form-control" placeholder="우편 ID" @bind="lookupMailId" />
            <button class="btn btn-outline-secondary" @onclick="LoadMailAsync" disabled="@busy">조회</button>
        </div>

        @if (mail is null)
        {
            <p class="muted">불러온 우편 정의가 없습니다.</p>
        }
        else
        {
            <dl class="snapshot-list">
                <dt>우편 ID</dt>
                <dd>@mail.MailId</dd>
                <dt>사고 ID</dt>
                <dd>@mail.IncidentId</dd>
                <dt>사유</dt>
                <dd>@mail.Reason</dd>
                <dt>생성 시각</dt>
                <dd>@mail.CreatedAt.ToString("u")</dd>
            </dl>

            <table class="ops-table">
                <thead>
                    <tr>
                        <th>재화</th>
                        <th>수량</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reward in mail.Rewards)
                    {
                        <tr>
                            <td>@reward.Currency</td>
                            <td>@reward.Amount</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</section>

<section class="ops-grid">
    <div class="ops-panel">
        <div class="panel-heading">
            <h2>대상자 확인</h2>
            <span class="status status-warning">Redis / DB</span>
        </div>
        <div class="lookup-row">
            <input class="form-control" placeholder="플레이어 ID" @bind="targetPlayerId" />
            <button class="btn btn-outline-secondary" @onclick="CheckTargetAsync" disabled="@busy">확인</button>
        </div>
        @if (targetCheck is not null)
        {
            <p class="result @(targetCheck.Targeted ? "result-ok" : "result-error")">
                <strong>@(targetCheck.Targeted ? "대상자" : "대상 아님")</strong>
                <span class="mono">@targetCheck.PlayerId</span>
            </p>
        }
    </div>

    <div class="ops-panel">
        <div class="panel-heading">
            <h2>보상 수령</h2>
            <span class="status status-draft">멱등 처리</span>
        </div>
        <div class="form-grid claim-grid">
            <label>
                플레이어 ID
                <input class="form-control" @bind="claim.PlayerId" />
            </label>
            <label>
                멱등성 키
                <input class="form-control" @bind="claim.IdempotencyKey" />
            </label>
            <label>
                요청 Hash
                <input class="form-control" @bind="claim.RequestHash" />
            </label>
            <label>
                우편 ID
                <input class="form-control" @bind="claim.MailId" />
            </label>
        </div>
        <div class="button-row">
            <AuthorizeView Roles="LiveOpsOperator,LiveOpsSupervisor">
                <button class="btn btn-primary" @onclick="ClaimMailAsync" disabled="@busy">수령</button>
                <button class="btn btn-outline-secondary" @onclick="ReplayClaimAsync" disabled="@busy">동일 요청 재전송</button>
            </AuthorizeView>
        </div>

        @if (receipt is not null)
        {
            <dl class="snapshot-list compact">
                <dt>기존 응답</dt>
                <dd>@(receipt.Replayed ? "예" : "아니요")</dd>
                <dt>원장 버전</dt>
                <dd>@receipt.Snapshot.LedgerVersion</dd>
                <dt>재화</dt>
                <dd>@FormatBalances(receipt.Snapshot.Balances)</dd>
            </dl>
        }
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(message))
{
    <section class="result @(messageIsError ? "result-error" : "result-ok")">
        <strong>@message</strong>
    </section>
}

@code {
    private MailDefinitionDto? mail;
    private MailTargetCheckDto? targetCheck;
    private PlayerCommandReceipt? receipt;
    private bool busy;
    private bool messageIsError;
    private string? message;
    private string lookupMailId = "";
    private string targetPlayerId = "";
    private DraftMailModel draft = DraftMailModel.CreateDefault();
    private ClaimMailModel claim = ClaimMailModel.CreateDefault();

    private async Task CreateMailAsync()
    {
        await RunAsync(async () =>
        {
            if (!TryBuildCreateCommand(out var command, out var error))
            {
                Fail(error);
                return;
            }

            mail = await ApiClient.CreateIncidentMailAsync(command);
            lookupMailId = mail.MailId;
            claim.MailId = mail.MailId;
            targetPlayerId = command.TargetPlayerIds[0].ToString();
            claim.PlayerId = targetPlayerId;
            message = $"우편을 생성했습니다: {mail.MailId}";
        });
    }

    private async Task LoadMailAsync()
    {
        await RunAsync(async () =>
        {
            var mailId = string.IsNullOrWhiteSpace(lookupMailId) ? draft.MailId : lookupMailId;
            mail = await ApiClient.GetMailAsync(mailId);
            if (mail is null)
            {
                Fail($"우편을 찾을 수 없습니다: {mailId}");
                return;
            }

            lookupMailId = mail.MailId;
            claim.MailId = mail.MailId;
            message = $"우편을 불러왔습니다: {mail.MailId}";
        });
    }

    private async Task CheckTargetAsync()
    {
        await RunAsync(async () =>
        {
            if (!Guid.TryParse(targetPlayerId, out var playerId))
            {
                Fail("플레이어 ID가 올바른 GUID 형식이 아닙니다.");
                return;
            }

            var mailId = mail?.MailId ?? lookupMailId;
            if (string.IsNullOrWhiteSpace(mailId))
            {
                Fail("우편 ID를 입력하세요.");
                return;
            }

            targetCheck = await ApiClient.CheckTargetAsync(mailId, playerId);
            message = targetCheck.Targeted ? "보상 대상자입니다." : "대상자 스냅샷에 포함되지 않은 플레이어입니다.";
            messageIsError = !targetCheck.Targeted;
        });
    }

    private Task ClaimMailAsync() => RunClaimAsync();

    private Task ReplayClaimAsync() => RunClaimAsync();

    private async Task RunClaimAsync()
    {
        await RunAsync(async () =>
        {
            if (!Guid.TryParse(claim.PlayerId, out var playerId))
            {
                Fail("수령할 플레이어 ID가 올바른 GUID 형식이 아닙니다.");
                return;
            }

            if (string.IsNullOrWhiteSpace(claim.MailId))
            {
                Fail("수령할 우편 ID를 입력하세요.");
                return;
            }

            receipt = await ApiClient.ClaimMailAsync(
                playerId,
                new ClaimMailCommand(claim.MailId, claim.IdempotencyKey, claim.RequestHash));
            message = receipt.Replayed ? "저장된 수령 응답을 반환했습니다." : "우편 보상을 수령했습니다.";
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        busy = true;
        message = null;
        messageIsError = false;
        try
        {
            await action();
        }
        catch (HttpRequestException ex)
        {
            Fail(ex.Message);
        }
        finally
        {
            busy = false;
        }
    }

    private bool TryBuildCreateCommand(out CreateIncidentMailCommand command, out string error)
    {
        command = new CreateIncidentMailCommand("", "", "", "", [], [], "");
        error = "";

        if (!Enum.TryParse<CurrencyCode>(draft.Currency, out var currency))
        {
            error = "보상 재화가 올바르지 않습니다.";
            return false;
        }

        var targetIds = ParsePlayerIds(draft.TargetPlayerIds);
        if (targetIds.Count == 0)
        {
            error = "대상 플레이어 ID를 하나 이상 입력하세요.";
            return false;
        }

        command = new CreateIncidentMailCommand(
            draft.IncidentId,
            draft.MailId,
            draft.Title,
            draft.Body,
            targetIds,
            [new MailRewardDto(currency, draft.Amount)],
            draft.Reason);
        return true;
    }

    private static IReadOnlyList<Guid> ParsePlayerIds(string value) =>
        value.Split([',', '\r', '\n', ' ', '\t'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(text => Guid.TryParse(text, out var id) ? id : Guid.Empty)
            .Where(id => id != Guid.Empty)
            .Distinct()
            .ToArray();

    private static string FormatBalances(IReadOnlyList<CurrencyBalanceDto> balances) =>
        balances.Count == 0
            ? "없음"
            : string.Join(", ", balances.Select(balance => $"{balance.Currency}:{balance.Amount}"));

    private void ResetDraft()
    {
        draft = DraftMailModel.CreateDefault();
        lookupMailId = draft.MailId;
        targetPlayerId = draft.FirstTargetId;
        claim = ClaimMailModel.CreateDefault(draft.MailId, draft.FirstTargetId);
        mail = null;
        receipt = null;
        targetCheck = null;
        message = null;
    }

    private void Fail(string error)
    {
        message = error;
        messageIsError = true;
    }

    private sealed class DraftMailModel
    {
        public string IncidentId { get; set; } = "";

        public string MailId { get; set; } = "";

        public string Title { get; set; } = "";

        public string Body { get; set; } = "";

        public string Currency { get; set; } = nameof(CurrencyCode.Elif);

        public long Amount { get; set; }

        public string TargetPlayerIds { get; set; } = "";

        public string Reason { get; set; } = "";

        public string FirstTargetId => TargetPlayerIds.Split(Environment.NewLine)[0];

        public static DraftMailModel CreateDefault()
        {
            var now = DateTimeOffset.UtcNow;
            var playerId = Guid.NewGuid();
            return new DraftMailModel
            {
                IncidentId = $"incident-{now:yyyyMMdd-HHmm}",
                MailId = $"mail-{now:yyyyMMdd-HHmm}",
                Title = "사고 보상",
                Body = "영향받은 가챠 요청에 대한 보상입니다.",
                Amount = 300,
                Reason = "사고 보상",
                TargetPlayerIds = playerId.ToString()
            };
        }
    }

    private sealed class ClaimMailModel
    {
        public string PlayerId { get; set; } = "";

        public string MailId { get; set; } = "";

        public string IdempotencyKey { get; set; } = "claim-mail-1";

        public string RequestHash { get; set; } = "claim-mail-hash-1";

        public static ClaimMailModel CreateDefault(string mailId = "", string playerId = "") =>
            new()
            {
                PlayerId = playerId,
                MailId = mailId
            };
    }
}
