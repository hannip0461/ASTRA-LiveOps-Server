@page "/outbox"
@rendermode InteractiveServer
@using Astra.Admin.Services
@using Astra.Contracts
@attribute [Authorize]
@inject OutboxAdminApiClient ApiClient

<PageTitle>Outbox 운영</PageTitle>

<section class="ops-header">
    <div>
        <p class="eyebrow">이벤트 전달</p>
        <h1>Outbox 전달 현황</h1>
        <p class="muted">비동기 전달 대기열과 최종 실패 이벤트를 확인합니다.</p>
    </div>
    <button class="btn btn-outline-secondary" @onclick="LoadAsync" disabled="@busy">새로고침</button>
</section>

@if (overview is not null)
{
    <section class="outbox-summary" aria-label="Outbox 상태 요약">
        <div><span>대기</span><strong>@overview.PendingCount</strong></div>
        <div><span>처리 중</span><strong>@overview.ProcessingCount</strong></div>
        <div><span>발행 완료</span><strong>@overview.PublishedCount</strong></div>
        <div class="@(overview.DeadLetterCount > 0 ? "metric-alert" : null)"><span>최종 실패</span><strong>@overview.DeadLetterCount</strong></div>
        <div><span>전달 완료</span><strong>@overview.DeliveryCount</strong></div>
        <div><span>최장 대기</span><strong>@FormatAge(overview.OldestPendingAtUtc)</strong></div>
    </section>
}

<section class="ops-panel">
    <div class="panel-heading">
        <h2>최종 실패 이벤트</h2>
        <span class="status @(deadLetters.Count > 0 ? "status-error" : "status-live")">@(deadLetters.Count)건</span>
    </div>

    <label class="block-label replay-reason">
        재처리 사유
        <input class="form-control" maxlength="500" @bind="replayReason" placeholder="책임자 재처리 시 필수" />
    </label>

    @if (deadLetters.Count == 0)
    {
        <p class="muted compact">최종 실패 이벤트가 없습니다.</p>
    }
    else
    {
        <div class="table-scroll">
            <table class="ops-table outbox-table">
                <thead>
                    <tr>
                        <th>실패 시각</th>
                        <th>이벤트</th>
                        <th>집계 ID</th>
                        <th>오류</th>
                        <th>시도</th>
                        <th>재처리</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in deadLetters)
                    {
                        <tr>
                            <td>@entry.DeadLetteredAtUtc?.ToString("MM-dd HH:mm:ss")</td>
                            <td>
                                <strong>@entry.EventType</strong>
                                <div class="muted mono">@entry.EventId</div>
                            </td>
                            <td class="mono">@entry.AggregateId</td>
                            <td><span class="status status-error">@entry.ErrorCode</span></td>
                            <td>@entry.Attempts / @entry.MaxAttempts</td>
                            <td>@entry.ManualReplayCount</td>
                            <td>
                                <AuthorizeView Roles="@LiveOpsRoles.Supervisor">
                                    <Authorized>
                                        <button class="btn btn-sm btn-outline-danger"
                                                disabled="@(busy || string.IsNullOrWhiteSpace(replayReason))"
                                                @onclick="() => ReplayAsync(entry.EventId)">
                                            재처리
                                        </button>
                                    </Authorized>
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@if (!string.IsNullOrWhiteSpace(message))
{
    <section class="result @(isError ? "result-error" : "result-ok")"><strong>@message</strong></section>
}

@code {
    private OutboxOverviewDto? overview;
    private IReadOnlyList<OutboxDeadLetterDto> deadLetters = [];
    private string replayReason = "";
    private string? message;
    private bool isError;
    private bool busy;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        busy = true;
        message = null;
        try
        {
            var overviewTask = ApiClient.GetOverviewAsync();
            var deadLettersTask = ApiClient.GetDeadLettersAsync();
            await Task.WhenAll(overviewTask, deadLettersTask);
            overview = await overviewTask;
            deadLetters = await deadLettersTask;
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException)
        {
            isError = true;
            message = exception.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ReplayAsync(Guid eventId)
    {
        busy = true;
        message = null;
        try
        {
            var result = await ApiClient.ReplayAsync(eventId, replayReason.Trim());
            isError = false;
            message = $"이벤트를 재처리 대기열에 추가했습니다: {result.EventId} (수동 재처리 {result.ManualReplayCount}회)";
            replayReason = "";
            overview = await ApiClient.GetOverviewAsync();
            deadLetters = await ApiClient.GetDeadLettersAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException)
        {
            isError = true;
            message = exception.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private static string FormatAge(DateTimeOffset? oldestPending) => oldestPending is null
        ? "-"
        : $"{Math.Max(0, (DateTimeOffset.UtcNow - oldestPending.Value).TotalSeconds):0}초";
}
