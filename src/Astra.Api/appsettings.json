{
  "Astra": {
    "Api": {
      "MaxRequestBodyBytes": 1048576
    },
    "Postgres": {
      "MinimumPoolSize": 0,
      "MaximumPoolSize": 8,
      "ConnectionTimeout": "00:00:03",
      "CommandTimeout": "00:00:15",
      "ConnectionIdleLifetime": "00:01:00",
      "ConnectionPruningInterval": "00:00:10",
      "ConnectionLifetime": "00:30:00"
    },
    "RateLimits": {
      "Window": "00:01:00",
      "DevAuthenticationPermitLimit": 20,
      "ViewerReadPermitLimit": 120,
      "OperatorReadPermitLimit": 180,
      "SupervisorReadPermitLimit": 240,
      "OperatorMutationPermitLimit": 30,
      "SupervisorMutationPermitLimit": 60
    },
    "LiveOpsAuth": {
      "Authority": "",
      "Issuer": "astra-liveops",
      "Audience": "astra-liveops-admin-api",
      "SigningKey": "",
      "RequireHttpsMetadata": true,
      "NameClaimType": "name",
      "RoleClaimType": "role",
      "TokenLifetime": "00:30:00",
      "DevTokenEnabled": false,
      "DevTokenKey": "",
      "DevOperators": []
    },
    "Audit": {
      "StoreProvider": "PostgreSQL"
    },
    "OpenTelemetry": {
      "Enabled": true,
      "ConsoleExporter": false,
      "OtlpEndpoint": ""
    }
  },
  "ConnectionStrings": {},
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
